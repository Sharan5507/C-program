#include <string.h>

int romanToInt(char* s) {
    int map[256] = {0};
    map['I'] = 1;
    map['V'] = 5;
    map['X'] = 10;
    map['L'] = 50;
    map['C'] = 100;
    map['D'] = 500;
    map['M'] = 1000;

    int total = 0;
    int len = strlen(s);

    for (int i = 0; i < len; i++) {
        int current_val = map[(unsigned char)s[i]];
        int next_val = (i + 1 < len) ? map[(unsigned char)s[i + 1]] : 0;

        if (current_val < next_val) {
            total -= current_val;
        } else {
            total += current_val;
        }
    }

    return total;
}
