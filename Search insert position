#include <stdio.h>

int searchInsert(int* nums, int numsSize, int target) {
    if (nums == NULL || numsSize == 0) {
        return 0;
    }

    int left = 0;
    int right = numsSize - 1;

    while (left <= right) {
        int mid = left + (right - left) / 2;

        if (nums[mid] == target) {
            return mid; // Target found, return its current index
        } else if (nums[mid] < target) {
            left = mid + 1; // Target is larger, discard the left half
        } else {
            right = mid - 1; // Target is smaller, discard the right half
        }
    }

    // If target is not found, 'left' points to the correct insertion index
    return left;
}
